# Copy to host.toml on the machine after live discovery. No secrets.
# Public repo keeps only this example — absolute private paths stay local.
slug = "macbook-pro"
hostname = "REPLACE-with-hostname-command"
username = "$USER"
os = "macOS"
arch = "aarch64"
home = "$HOME"
role = "primary-laptop-admin"
home_admin_agents = "$HOME/AGENTS.md"
system_path = "$HOME/system"
github_repos_path = "$HOME/github-repos"
umbrella_local = "$HOME/github-repos/tyler-jewell"
llm_gpu = "yes"   # only if live Metal / LLM GPU probe says so
# Mesh-LLM — primary OpenAI-compatible local/mesh layer (no model name inventory here)
mesh_llm_base_url = "http://127.0.0.1:9337/v1"
mesh_llm_role = "server-capable"   # server | server-capable | client-only | unavailable