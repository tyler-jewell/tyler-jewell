# Copy to host.toml when a real Studio is enrolled. No secrets. No private absolute homes in public git.
slug = "mac-studio"
hostname = "REPLACE-with-hostname"
username = "$USER"
os = "macOS"
arch = "aarch64"
home = "$HOME"
llm_gpu = "yes"
full_setup_eligible = "yes"
role = "studio-workstation"
ssh_alias = "studio"
umbrella_local = "$HOME/github-repos/tyler-jewell"
mesh_llm_base_url = "http://127.0.0.1:9337/v1"
mesh_llm_role = "server-capable"
