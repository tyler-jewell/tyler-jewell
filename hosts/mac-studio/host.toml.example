# Copy to host.toml when a real Studio is enrolled. No secrets.
slug = "mac-studio"
hostname = "REPLACE-hostname"
username = "REPLACE-user"
os = "macOS"
arch = "aarch64"
home = "/Users/REPLACE-user"
llm_gpu = "yes"
full_setup_eligible = "yes"
role = "studio-workstation"
ssh_alias = "studio"
umbrella_local = "/Users/REPLACE-user/github-repos/tyler-jewell"
